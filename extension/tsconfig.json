{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "./dist",
    "declaration": false,
    "resolveJsonModule": true,
    "types": ["firefox-webext-browser"]
  },
  "include": ["src"],
  "exclude": ["dist", "node_modules"]
}
